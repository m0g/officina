{#- Only shown when nobody has answered yet. Until then PostHog is already
    counting the visit cookielessly, so the copy says what accepting actually
    adds rather than asking for a favour. -#}
<div id="cookie-banner" class="hidden bottom-0 left-0 right-0 bg-kobi z-401 border-t border-black">
  <div class="p-6 max-w-screen-xl mx-auto">
    <p class="max-w-2xl">
      {{ ui.cookieText }}
    </p>
    <button
      id="accept-cookie"
      class="text-white text-smc font-bold bg-black px-8 py-2 mt-4 mr-2 inline-block transition-colors duration-150 hover:bg-blue-custom"
    >{{ ui.cookieAccept }}</button>
    <button
      id="decline-cookie"
      class="text-black text-smc font-bold border-2 border-black px-8 py-2 mt-4 inline-block transition-colors duration-150 hover:bg-black hover:text-white"
    >{{ ui.cookieDecline }}</button>
  </div>
</div>
