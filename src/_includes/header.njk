<header
  class="z-900 flex bg-white fixed top-0 inset-x-0 z-100 xl:h-16 items-center border-b border-black"
>
  <div
    class="w-full max-w-screen-xl relative mx-auto px-4 flex flex-col xl:flex-row"
  >
    <div class="flex flex-shrink-0 py-4 xl:py-0">
      <button
        type="button"
        id="sidebar-open"
        aria-label="Open the sidebar"
        class="flex mr-2 px-2 items-center xl:hidden text-black focus:outline-none focus:text-gray-700"
      >
        <svg
          class="fill-current w-4 h-4"
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 20 20"
        >
          <path d="M0 3h20v2H0V3zm0 6h20v2H0V9zm0 6h20v2H0v-2z"></path>
        </svg>
      </button>
      <a href="/{{ page.lang }}/" class="font-plex font-bold text-xl pt-1 md:pt-1">
        <img
          src="/_assets/img/logo.gif"
          class="object-contain"
          height="59px"
          alt="Officina Kreuzberg"
          title="Officina Kreuzberg"
        />
      </a>
    </div>
    <div
      id="sidebar"
      class="flex flex-col items-start pb-4 xl:pb-0 ml-6 xl:flex-row xl:items-stretch xl:flex-grow xl:justify-end hidden xl:flex text-smc font-bold"
    >
      <a
        href="/{{ page.lang }}/"
        class="py-2 px-4 my-3 mr-5 transition-colors duration-150 hover:text-blue-custom"
        hx-get="/{{ page.lang }}/"
        hx-select="main"
        hx-target="main"
        hx-swap="outerHTML show:top"
        hx-push-url="true"
      >
        {{ menu.desks }}
      </a>
      <a
        href="/{{page.lang}}/about"
        class="py-2 px-4 my-3 mr-5 transition-colors duration-150 hover:text-blue-custom"
        hx-get="/{{page.lang}}/about"
        hx-select="main"
        hx-target="main"
        hx-swap="outerHTML show:top"
        hx-push-url="true"
      >
        {{ menu.about }}
      </a>
      <a
        href="/en/collective"
        class="py-2 px-4 my-3 mr-5 transition-colors duration-150 hover:text-blue-custom"
        hx-get="/en/collective"
        hx-select="main"
        hx-target="main"
        hx-swap="outerHTML show:top"
        hx-push-url="true"
      >
        {{ menu.collective }}
      </a>
      <!-- <a
        href="/en/artists"
        class="py-2 px-4 my-3 mr-5 transition-colors duration-150 hover:text-blue-custom"
        hx-get="/en/artists"
        hx-select="main"
        hx-target="main"
        hx-swap="outerHTML show:top"
        hx-push-url="true"
      >
        {{ menu.artists }}
      </a> -->
      <a
        href="/en/events"
        class="py-2 px-4 my-3 mr-5 transition-colors duration-150 hover:text-blue-custom"
        hx-get="/en/events"
        hx-select="main"
        hx-target="main"
        hx-swap="outerHTML show:top"
        hx-push-url="true"
      >
        {{ menu.events }}
      </a>
      <a
        href="https://www.instagram.com/officinakreuzberg/"
        target="_blank"
        data-ph-location="header"
        class="py-2 px-4 my-3 mr-5 bg-yellow-custom border-2 border-black transition-colors duration-150 hover:bg-black hover:text-yellow-custom"
      >
        Instagram
      </a>
      <a
        href="https://docs.google.com/forms/d/e/1FAIpQLSe_aJwPcxRE_1LtocSHlrjHqDOQhm763ElOiURhH6KCOzL96g/viewform"
        target="_blank"
        data-ph-location="header"
        class="w-2/3 xl:w-auto bg-black text-white py-2 px-4 my-3 transition-colors duration-150 hover:bg-blue-custom"
      >
        {{ menu.contact }}
      </a>
    </div>
  </div>
</header>
