{%- set siteName = "Officina Kreuzberg" -%}
{%- set defaultDescription = "Officina Kreuzberg is a member-run coworking space in Berlin Kreuzberg, near Hermannplatz. Fix desks, flex desks and a private room, with 24/7 access, a big kitchen and a terrace." if features.room else "Officina Kreuzberg is a member-run coworking space in Berlin Kreuzberg, near Hermannplatz. Fix desks and flex desks, with 24/7 access, a big kitchen and a terrace." -%}
{%- set pageTitle = seo_title or siteName -%}
{%- set pageDescription = (meta_description_room if features.room and meta_description_room else meta_description) or defaultDescription -%}
{# Netlify serves about.html at the extensionless /en/about, which is what every
   internal link uses – keep the canonical and the alternates on that same URL. #}
{%- set pageUrl = page.url | replace(".html", "") | absoluteUrl -%}
{%- set ogImage = (image | replace('/src/', '/')) if image else '/_assets/images/uploads/officina_space_web_2.jpg' -%}
<!DOCTYPE html>
<html lang="{{ page.lang }}">
  <head>
    <meta charset="utf-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, shrink-to-fit=no"
    />
    <title>{{ pageTitle }}</title>
    <meta name="description" content="{{ pageDescription }}" />
    <meta name="keywords" content="officina, berlin, kreuzberg, neukölln, coworking, co-working, shared workspace, desk" />
    <link rel="canonical" href="{{ pageUrl }}" />
    {%- for link in page.url | locale_links %}
    <link rel="alternate" hreflang="{{ link.lang }}" href="{{ link.url | replace(".html", "") | absoluteUrl }}" />
    {%- endfor %}
    <link rel="alternate" hreflang="{{ page.lang }}" href="{{ pageUrl }}" />
    {%- if page.lang == "en" %}
    <link rel="alternate" hreflang="x-default" href="{{ pageUrl }}" />
    {%- endif %}
    <meta property="og:locale" content="{% if page.lang == 'de' %}de_DE{% else %}en_US{% endif %}" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content="{{ pageTitle }}" />
    <meta property="og:description" content="{{ pageDescription }}" />
    <meta property="og:url" content="{{ pageUrl }}" />
    <meta property="og:image" content="{{ ogImage | absoluteUrl }}" />
    <meta property="og:site_name" content="{{ siteName }}" />
    <meta name="twitter:card" content="summary_large_image" />
    <link
      rel="icon"
      type="image/png"
      href="/_assets/img/favicon/16px.png"
      sizes="16x16"
    />
    <link
      rel="icon"
      type="image/png"
      href="/_assets/img/favicon/32px.png"
      sizes="32x32"
    />
    <link
      rel="icon"
      type="image/png"
      href="/_assets/img/favicon/256px.png"
      sizes="256x256"
    />
    <link
      rel="icon"
      type="image/png"
      href="/_assets/img/favicon/480px.png"
      sizes="480x480"
    />
    <link
      rel="icon"
      type="image/png"
      href="/_assets/img/favicon/1024px.png"
      sizes="1024x1024"
    />
    <link
      rel="apple-touch-icon"
      sizes="180x180"
      href="/_assets/img/favicon/apple-touch-icon.png"
    />
    <meta name="msapplication-TileColor" content="#da532c" />
    <meta name="theme-color" content="#ffffff" />
    <link rel="preload" href="/IBM-Plex-Sans/fonts/complete/woff2/IBMPlexSans-Regular.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/IBM-Plex-Sans/fonts/complete/woff2/IBMPlexSans-Bold.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="stylesheet" href="/css/leaflet.css" type="text/css" />
    <link rel="stylesheet" href="/css/plex.css" type="text/css" />
    <link rel="stylesheet" href="/css/styles.css" type="text/css" />
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "LocalBusiness",
      "name": {{ siteName | dump | safe }},
      "description": {{ defaultDescription | dump | safe }},
      "url": "{{ '/en/' | absoluteUrl }}",
      "email": "hello@officina.berlin",
      "image": "{{ '/_assets/images/uploads/officina_space_web_2.jpg' | absoluteUrl }}",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "Jahnstraße 13",
        "postalCode": "10967",
        "addressLocality": "Berlin",
        "addressCountry": "DE"
      },
      "geo": {
        "@type": "GeoCoordinates",
        "latitude": 52.48840,
        "longitude": 13.41973
      },
      "priceRange": {{ ("155 € – 600 € per month" if features.room else "155 € – 255 € per month") | dump | safe }},
      "sameAs": [
        "https://www.instagram.com/officinakreuzberg/",
        "https://www.facebook.com/OfficinaNeukoelln/"
      ]
    }
    </script>
  </head>
  <body class="text-gray-900 leading-normal font-plex overflow-x-hidden">
    {% include 'header.njk' %}
    <main class="w-full mt-36 md:mt-0 overflow-x-hidden" hx-boost="true">
      {{ content | safe }}
    </main>
    {% include 'footer.njk' %}
    {% include 'cookie-banner.njk' %}
    <script type="module" src="/js/index.js"></script>
  </body>
</html>
